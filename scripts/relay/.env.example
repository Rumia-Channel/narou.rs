# 自宅回線リレーの設定例。
# このファイルを同じディレクトリの `.env` にコピーして値を書き換える。
# `.env` は秘密情報を含むため git 管理外 (.gitignore 済み)。

# 認証キー。32 バイト以上のランダム値を作る:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
NAROU_RELAY_KEY=

# リレーに取得を許可するホスト (カンマ区切りの完全一致)。
# ハーメルンならこの 3 つ。Pixiv も使うなら www.pixiv.net を追加する。
NAROU_RELAY_ALLOWED_HOSTS=syosetu.org,www.syosetu.org,h.syosetu.org

# 待受ポート。home-relay.ps1 の -Port で上書きできる。
PORT=3000

# 任意: TLS 検証に使う CA バンドル (PEM)。curl / wget / Node の全経路で共有する。
# 2026-10-20 の eMudhra 中間 CA 侵害では、侵害ルートを含むバンドルでの起動を
# 拒否する。Linux なら ca-certificates を更新したうえでシステムバンドルを指す:
#   NAROU_RELAY_CACERT=/etc/ssl/certs/ca-certificates.crt
# 未設定の場合は同梱/取得した CA バンドル、無ければ各クライアントの既定ストア。
# NAROU_RELAY_CACERT=

