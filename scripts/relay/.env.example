# 自宅回線リレー (Rust 版 narou_relay) の設定例。
# このファイルを同じディレクトリの `.env` にコピーして値を書き換える。
# `.env` は秘密情報を含むため git 管理外 (.gitignore 済み)。
# home-relay.ps1 は NAROU_RELAY_ENV_FILE でこのファイルを明示してバイナリを起動する。

# 認証キー。32 バイト以上のランダム値を作る:
#   openssl rand -base64 32
#   PowerShell 7: [Convert]::ToBase64String([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
# (Get-Random / System.Random は暗号学的乱数ではないため鍵に使わない)
# Worker 側の同名 Secret と完全に一致させる。
NAROU_RELAY_KEY=

# リレーに取得を許可するホスト (カンマ区切りの完全一致)。`*` や URL は不可。
# ハーメルンならこの 3 つ。Pixiv も使うなら www.pixiv.net を追加する。
# 未設定・空のときは、認証が正しくても取得をすべて拒否する。
NAROU_RELAY_ALLOWED_HOSTS=syosetu.org,www.syosetu.org,h.syosetu.org

# 待受ポート。home-relay.ps1 の -Port で上書きできる。
PORT=3000

# 取得クライアントの順序 (カンマ区切り)。既定は `curl,wget`。
# `wget` が見つからない場合は起動時に取得順から外れる。未知の名前は起動エラー。
# VPS 等で curl が Cloudflare の challenge (403) になる場合は wget を先頭にする:
#NAROU_RELAY_FETCH=wget,curl

# 任意: TLS 検証に使う CA バンドル (PEM)。
# 指定すると curl の --cacert / wget の --ca-certificate に渡され、
# クライアント既定の CA ストアを置き換える。未設定なら各クライアントの既定。
# Rust リレーは起動時にこのバンドルを検証し、既知の侵害ルート証明書
# (2026-10-20 の eMudhra 中間 CA 侵害で失効) を含んでいれば
# `narou relay startup failed: CA バンドルを検証できません` で起動を止める。
# Linux なら ca-certificates を更新したうえでシステムバンドルを指す:
#   NAROU_RELAY_CACERT=/etc/ssl/certs/ca-certificates.crt
# Windows は OS の証明書ストアを使う curl (Schannel) / wget の既定で通常は不要。
#NAROU_RELAY_CACERT=

# 任意: curl / wget の実行ファイルを明示する (既定は PATH の curl / wget)。
#NAROU_RELAY_CURL=
#NAROU_RELAY_WGET=
