# SORAHOST の起動環境変数のひな形。
# Pterodactyl の Startup 変数として設定するか、コンテナ内の .env として
# サーバー起動前に読み込ませて下さい (start.sh は環境変数だけを見ます)。

# --- 公開 (Cloudflare Tunnel) --------------------------------------------
# cloudflared のトークンはこのファイルではなく、トークン専用のファイルへ
# 置いて下さい (既定 $NAROU_RS_ROOT/.cloudflared-token、chmod 600)。
#   TUNNEL_TOKEN_FILE=/home/container/narou/.cloudflared-token

# Web UI の basic 認証 (公開エンドポイントなので必須)。
NAROU_WEB_USER=admin
NAROU_WEB_PASSWORD=change-me

# --- 保存先 (挿絵だけ S3) -------------------------------------------------
# s3 を指定すると挿絵のバイナリだけを S3 互換ストレージへ置く。本文・
# メタデータはライブラリ内 (SQLite) に残る。値が欠けていると起動に失敗する
# (黙ってローカル保存へ落ちない)。
NAROU_RS_ASSET_BACKEND=s3
S3_ENDPOINT=https://s3.ap-northeast-1.wasabisys.com
S3_BUCKET=your-bucket
S3_REGION=ap-northeast-1
S3_PREFIX=narou/library
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key

# --- 容量 (任意) ----------------------------------------------------------
# start.sh は初回に economy=nosave_diff と convert.no-epub=true を入れる。
# raw HTML も保存しないなら economy の値に nosave_raw を足す (挿絵の再ローカ
# ライズが raw/*.html を見られなくなるので、容量と引き換えの判断)。
# start.sh が `convert.section-cache=false` を設定するので通常は不要。
# 環境変数で切りたい場合は 0 を指定する (再変換は遅くなるが容量を使わない)。
NAROU_RS_SECTION_CACHE=0

# --- 配置 (既定のままでもよい) -------------------------------------------
# NAROU_RS_ROOT=/home/container/narou
# NAROU_RS_LIBRARY=/home/container/narou/library
# NAROU_RS_PORT=8080
