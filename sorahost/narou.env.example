# SORAHOST の起動環境変数のひな形。
# start.sh は起動時に **ボリューム直下の `.env`** を読み込む
# (パネルのファイルマネージャか SFTP で置く。既に環境にある値が優先される)。
# Pterodactyl の Startup 変数で同じ名前を定義できるなら、そちらに置いても動く。
# 形式は `KEY=VALUE` の行、`#` から始まる行は無視。
# CI から配備する場合に必要なのは SORAHOST_ENDPOINT / SORAHOST_TOKEN の 2 つだけで、
# ここに書く値はサーバー側に置きます (sorahost/README.md §3)。

# --- 公開 ----------------------------------------------------------------
# 公開は PteWorker が行う。アプリはプラットフォームから渡される PORT に
# ループバックで束縛するので、リバースプロキシは要らない。

# Web UI の basic 認証 (公開エンドポイントなので必須)。
NAROU_WEB_USER=admin
NAROU_WEB_PASSWORD=change-me

# --- 前段 (任意。Cloudflare のコネクタ + Access) ---------------------------
# 置くと cloudflared を起動して TLS + Zero Trust の入口にする。
# トークンは Cloudflare のダッシュボード (Networks → Tunnels → コネクタ →
# Add a replica) で確認する。
# NAROU_CONNECTOR_TOKEN=eyJ...
# NAROU_PUBLIC_HOST=narou.example.com      # 公開ホスト名 (この Host 以外を弾く)
# NAROU_CONNECTOR_TOKEN_FILE=$VOLUME_DIR/.connector-token   # トークンをファイルで渡す場合

# --- 保存先 (挿絵だけ S3) -------------------------------------------------
# s3 を指定すると挿絵のバイナリだけを S3 互換ストレージへ置く。本文・
# メタデータはライブラリ内 (SQLite) に残る。値が欠けていると起動に失敗する
# (黙ってローカル保存へ落ちない)。
NAROU_RS_ASSET_BACKEND=s3
S3_ENDPOINT=https://s3.ap-northeast-1.wasabisys.com
S3_BUCKET=your-bucket
S3_REGION=ap-northeast-1
S3_PREFIX=narou/library
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key

# --- 容量 (任意) ----------------------------------------------------------
# start.sh は初回に economy=nosave_diff,nosave_raw / convert.no-epub=true /
# convert.keep-txt=false / convert.section-cache=false を入れる。
# 環境変数で切りたい場合は 0 を指定する (再変換は遅くなるが容量を使わない)。
NAROU_RS_SECTION_CACHE=0

# --- 配置 (既定のままでもよい) -------------------------------------------
# プロジェクトルート = コンテナのボリューム。app/ は配備で入れ替わり、
# library/ は配備に含めないので作品データはここに残る。
# NAROU_RS_APP=/home/container/app
# NAROU_RS_LIBRARY=/home/container/library
# NAROU_RS_PORT=8080          # 既定は PteWorker の PORT (リレー同居時は 8080)
# NAROU_RELAY=1               # 同じサーバーで取得リレーも動かす場合だけ (§10)
# NAROU_RS_ENV_FILE           # .env のパスを変えたいとき

